# macOS
.DS_Store

# Editors (project-agnostic IDE files belong in a global gitignore)
*.swp

# Python tooling
.venv/
__pycache__/

# CMake
build/
out/
CMakeUserPresets.json
compile_commands.json

# SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode (the project is generated by XcodeGen from macos/project.yml)
macos/*.xcodeproj/
macos/*.xcworkspace/
macos/DerivedData/
macos/Config/Signing.local.xcconfig
xcuserdata/
*.xcuserstate

# Visual Studio / .NET
.vs/
bin/
obj/
*.user
*.suo
TestResults/
*.nupkg

# Inno Setup output
windows/installer/Output/

# Claude Code local files (phase files and project docs are tracked)
.claude/*
!.claude/phases/

# Android
android/.gradle/
android/local.properties
android/app/.cxx/
android/.kotlin/
