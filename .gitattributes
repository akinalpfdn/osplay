# Normalize text to LF in the repository; Windows-only formats keep CRLF in the working tree.
* text=auto eol=lf

*.sln      text eol=crlf
*.slnx     text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.iss      text eol=crlf
*.isl      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

*.png      binary
*.ico      binary
*.icns     binary
*.pdf      binary
*.h264     binary
protocol/fixtures/** binary
