<!-- Single source of visual values for the shell. Colors come from WPF-UI's theme resources, which
     follow the system light/dark setting; reference them with DynamicResource so a switch shows live. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="Osplay.FontSize.Title">16</sys:Double>
  <sys:Double x:Key="Osplay.FontSize.Body">14</sys:Double>
  <sys:Double x:Key="Osplay.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="Osplay.FontSize.PairingCode">36</sys:Double>
  <sys:Double x:Key="Osplay.FontSize.Icon">20</sys:Double>
  <FontFamily x:Key="Osplay.Font.Monospace">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Osplay.FontWeight.Emphasis">SemiBold</FontWeight>
  <sys:Double x:Key="Osplay.Opacity.Disabled">0.5</sys:Double>

  <!-- Tray panel -->
  <sys:Double x:Key="Osplay.Width.Panel">360</sys:Double>
  <sys:Double x:Key="Osplay.Panel.EdgeMargin">12</sys:Double>
  <Thickness x:Key="Osplay.Thickness.PanelPadding">16</Thickness>
  <Thickness x:Key="Osplay.Thickness.SectionGap">0,12,0,0</Thickness>
  <Thickness x:Key="Osplay.Thickness.ItemGap">0,6,0,0</Thickness>
  <Thickness x:Key="Osplay.Thickness.CardPadding">12</Thickness>
  <Thickness x:Key="Osplay.Thickness.IconGap">0,0,12,0</Thickness>
  <Thickness x:Key="Osplay.Thickness.ButtonGap">0,0,8,0</Thickness>
  <CornerRadius x:Key="Osplay.CornerRadius.Card">6</CornerRadius>
  <Thickness x:Key="Osplay.Thickness.SelectedBorder">2</Thickness>
  <Thickness x:Key="Osplay.Thickness.CardBorder">1</Thickness>

  <!-- Monitor picker -->
  <sys:Double x:Key="Osplay.Height.MonitorPicker">110</sys:Double>
  <!-- The PC's network QR code: large enough for a phone camera at arm's length. -->
  <sys:Double x:Key="Osplay.Size.QrCode">168</sys:Double>
  <sys:Double x:Key="Osplay.MonitorPicker.Gap">6</sys:Double>
  <CornerRadius x:Key="Osplay.CornerRadius.Monitor">4</CornerRadius>

  <!-- Windows -->
  <sys:Double x:Key="Osplay.Width.SettingsWindow">600</sys:Double>
  <sys:Double x:Key="Osplay.Height.SettingsWindow">560</sys:Double>
  <Thickness x:Key="Osplay.Thickness.PagePadding">20,12,20,20</Thickness>
  <Thickness x:Key="Osplay.Thickness.DialogPadding">20</Thickness>
  <sys:Double x:Key="Osplay.Width.PairingDialog">340</sys:Double>
  <sys:Double x:Key="Osplay.Width.Button">96</sys:Double>
  <sys:Double x:Key="Osplay.Width.HotkeyButton">200</sys:Double>

  <!-- Tray icons: a dark glyph for a light taskbar, a light glyph for a dark one. -->
  <sys:String x:Key="Osplay.Tray.IconForLightTaskbar">pack://application:,,,/Assets/Tray-black.ico</sys:String>
  <sys:String x:Key="Osplay.Tray.IconForDarkTaskbar">pack://application:,,,/Assets/Tray-white.ico</sys:String>
</ResourceDictionary>
