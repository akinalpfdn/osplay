<!-- Single source of visual values for the shell. Light/dark dictionaries arrive with the shell UI. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="Osplay.Color.Accent">#FF2F6FEB</Color>
  <Color x:Key="Osplay.Color.OnAccent">#FFFFFFFF</Color>

  <SolidColorBrush x:Key="Osplay.Brush.SecondaryText" Color="{x:Static SystemColors.GrayTextColor}" />

  <sys:Double x:Key="Osplay.FontSize.Body">14</sys:Double>
  <sys:Double x:Key="Osplay.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="Osplay.FontSize.PairingCode">36</sys:Double>
  <FontFamily x:Key="Osplay.Font.Monospace">Cascadia Mono, Consolas</FontFamily>

  <Thickness x:Key="Osplay.Thickness.DialogPadding">20</Thickness>
  <Thickness x:Key="Osplay.Thickness.SectionGap">0,12,0,12</Thickness>
  <Thickness x:Key="Osplay.Thickness.ButtonGap">0,0,8,0</Thickness>
  <sys:Double x:Key="Osplay.Width.PairingDialog">320</sys:Double>
  <sys:Double x:Key="Osplay.Width.Button">88</sys:Double>
  <!-- Tray icons: a dark glyph for a light taskbar, a light glyph for a dark one. -->
  <sys:String x:Key="Osplay.Tray.IconForLightTaskbar">pack://application:,,,/Assets/Tray-black.ico</sys:String>
  <sys:String x:Key="Osplay.Tray.IconForDarkTaskbar">pack://application:,,,/Assets/Tray-white.ico</sys:String>
</ResourceDictionary>
