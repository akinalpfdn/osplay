<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 2004 SDK projections bring the WinRT Wi-Fi Direct API (Services/PcNetwork.cs). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Osplay</AssemblyName>
    <RootNamespace>Osplay.App</RootNamespace>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <!-- Function pointers and fixed buffers for the engine's C API (Interop/). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Osplay.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Tray-*.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osplay.Localization\Osplay.Localization.csproj" />
  </ItemGroup>

  <!-- The native engine from the CMake build (docs/BUILDING.md); override with
       -p:OsplayNativeBin=<folder> for another preset. -->
  <PropertyGroup>
    <OsplayNativeBin Condition="'$(OsplayNativeBin)' == ''">$(MSBuildThisFileDirectory)..\..\build\debug\bin</OsplayNativeBin>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OsplayNativeBin)\OsplayEngine.dll" Link="OsplayEngine.dll" Visible="false"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(OsplayNativeBin)\OsplayEngine.dll')" />
  </ItemGroup>

</Project>
