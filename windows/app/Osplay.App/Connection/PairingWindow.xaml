<Window x:Class="Osplay.App.Connection.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Osplay.Localization;assembly=Osplay.Localization"
        Title="{x:Static res:Strings.PairingTitle}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True">
  <StackPanel Margin="{StaticResource Osplay.Thickness.DialogPadding}" Width="{StaticResource Osplay.Width.PairingDialog}">
    <TextBlock x:Name="Message" TextWrapping="Wrap" TextAlignment="Center"
               FontSize="{StaticResource Osplay.FontSize.Body}" />
    <TextBlock x:Name="Code" HorizontalAlignment="Center"
               Margin="{StaticResource Osplay.Thickness.SectionGap}"
               FontFamily="{StaticResource Osplay.Font.Monospace}"
               FontSize="{StaticResource Osplay.FontSize.PairingCode}" FontWeight="SemiBold" />
    <TextBlock Text="{x:Static res:Strings.PairingHint}" TextWrapping="Wrap" TextAlignment="Center"
               Foreground="{StaticResource Osplay.Brush.SecondaryText}"
               FontSize="{StaticResource Osplay.FontSize.Caption}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Osplay.Thickness.SectionGap}">
      <Button Content="{x:Static res:Strings.PairingReject}" IsCancel="True" Click="OnReject"
              MinWidth="{StaticResource Osplay.Width.Button}" Margin="{StaticResource Osplay.Thickness.ButtonGap}" />
      <Button Content="{x:Static res:Strings.PairingAccept}" IsDefault="True" Click="OnAccept"
              MinWidth="{StaticResource Osplay.Width.Button}" />
    </StackPanel>
  </StackPanel>
</Window>
