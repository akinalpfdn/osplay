<ui:FluentWindow x:Class="Osplay.App.Settings.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Osplay.Localization;assembly=Osplay.Localization"
                 xmlns:settings="clr-namespace:Osplay.App.Settings"
                 xmlns:connection="clr-namespace:Osplay.App.Connection"
                 xmlns:controls="clr-namespace:Osplay.App.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
                 Title="{x:Static res:Strings.SettingsTitle}"
                 Width="{StaticResource Osplay.Width.SettingsWindow}"
                 Height="{StaticResource Osplay.Height.SettingsWindow}"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
  <DockPanel>
    <ui:TitleBar DockPanel.Dock="Top" Title="{x:Static res:Strings.SettingsTitle}" ShowMaximize="False" ShowMinimize="False" />
    <TabControl Margin="{StaticResource Osplay.Thickness.PagePadding}">
      <!-- General -->
      <TabItem Header="{x:Static res:Strings.SettingsGeneral}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ui:CardControl Margin="{StaticResource Osplay.Thickness.SectionGap}">
              <ui:CardControl.Header>
                <TextBlock Text="{x:Static res:Strings.SettingsStartWithWindows}" Style="{StaticResource Osplay.Text.Body}" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding StartsWithWindows}"
                               AutomationProperties.Name="{x:Static res:Strings.SettingsStartWithWindows}" />
            </ui:CardControl>
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{Binding StartupError}"
                       Style="{StaticResource Osplay.Text.Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding HasStartupError, Converter={StaticResource Osplay.Converter.BooleanToVisibility}}" />

            <ui:CardControl Margin="{StaticResource Osplay.Thickness.SectionGap}">
              <ui:CardControl.Header>
                <StackPanel>
                  <TextBlock Text="{x:Static res:Strings.SettingsStatsOverlay}" Style="{StaticResource Osplay.Text.Body}" />
                  <TextBlock Text="{x:Static res:Strings.SettingsStatsOverlayDetail}" Style="{StaticResource Osplay.Text.Caption}" />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding Settings.ShowsStatsOverlay}"
                               AutomationProperties.Name="{x:Static res:Strings.SettingsStatsOverlay}" />
            </ui:CardControl>

            <TextBlock Text="{x:Static res:Strings.SettingsHotkey}" Style="{StaticResource Osplay.Text.Section}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{x:Static res:Strings.SettingsHotkeyDetail}"
                       Style="{StaticResource Osplay.Text.Caption}" />
            <WrapPanel Margin="{StaticResource Osplay.Thickness.ItemGap}">
              <controls:HotkeyRecorder Margin="{StaticResource Osplay.Thickness.ButtonGap}" Gesture="{Binding ViewerHotkey}" />
              <ui:Button VerticalAlignment="Top" Content="{x:Static res:Strings.HotkeyReset}" Command="{Binding ResetHotkeyCommand}" />
            </WrapPanel>

            <TextBlock Text="{x:Static res:Strings.SettingsSwapHotkey}" Style="{StaticResource Osplay.Text.Section}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{x:Static res:Strings.SettingsSwapHotkeyDetail}"
                       Style="{StaticResource Osplay.Text.Caption}" />
            <WrapPanel Margin="{StaticResource Osplay.Thickness.ItemGap}">
              <controls:HotkeyRecorder Margin="{StaticResource Osplay.Thickness.ButtonGap}" Gesture="{Binding SwapHotkey}" />
              <ui:Button VerticalAlignment="Top" Content="{x:Static res:Strings.HotkeyReset}" Command="{Binding ResetSwapHotkeyCommand}" />
            </WrapPanel>
            <TextBlock Text="{x:Static res:Strings.SettingsStatsHotkey}" Style="{StaticResource Osplay.Text.Section}" />
            <WrapPanel Margin="{StaticResource Osplay.Thickness.ItemGap}">
              <controls:HotkeyRecorder Margin="{StaticResource Osplay.Thickness.ButtonGap}" Gesture="{Binding StatsHotkey}" />
              <ui:Button VerticalAlignment="Top" Content="{x:Static res:Strings.HotkeyReset}" Command="{Binding ResetStatsHotkeyCommand}" />
            </WrapPanel>
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{Binding HotkeyMessage}"
                       Style="{StaticResource Osplay.Text.Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding HasHotkeyMessage, Converter={StaticResource Osplay.Converter.BooleanToVisibility}}" />

            <TextBlock Text="{x:Static res:Strings.UpdatesTitle}" Style="{StaticResource Osplay.Text.Section}" />
            <ui:CardControl Margin="{StaticResource Osplay.Thickness.ItemGap}">
              <ui:CardControl.Header>
                <TextBlock Text="{x:Static res:Strings.UpdatesAutomatic}" Style="{StaticResource Osplay.Text.Body}" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding Settings.ChecksForUpdates}"
                               AutomationProperties.Name="{x:Static res:Strings.UpdatesAutomatic}" />
            </ui:CardControl>
            <WrapPanel Margin="{StaticResource Osplay.Thickness.ItemGap}">
              <ui:Button Margin="{StaticResource Osplay.Thickness.ButtonGap}" Content="{x:Static res:Strings.UpdatesCheckNow}"
                         Command="{Binding Updates.CheckNowCommand}" />
              <ui:Button Content="{x:Static res:Strings.UpdatesDownload}" Command="{Binding Updates.OpenDownloadCommand}"
                         Visibility="{Binding Updates.IsUpdateAvailable, Converter={StaticResource Osplay.Converter.BooleanToVisibility}}" />
            </WrapPanel>
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{Binding Updates.CheckResult}"
                       Style="{StaticResource Osplay.Text.Caption}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{Binding Updates.CurrentVersionText}"
                       Style="{StaticResource Osplay.Text.Caption}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Devices -->
      <TabItem Header="{x:Static res:Strings.SettingsDevices}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Margin="{StaticResource Osplay.Thickness.SectionGap}" Text="{x:Static res:Strings.SettingsDevicesDetail}"
                       Style="{StaticResource Osplay.Text.Caption}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.SectionGap}" Text="{x:Static res:Strings.SettingsNoDevices}"
                       Style="{StaticResource Osplay.Text.Body}"
                       Visibility="{Binding Connection.Peers.Count, Converter={StaticResource Osplay.Converter.ZeroToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Connection.Peers}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type connection:PeerItem}">
                  <ui:CardControl Margin="{StaticResource Osplay.Thickness.ItemGap}">
                    <ui:CardControl.Header>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Osplay.Text.Body}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Osplay.Text.Caption}" />
                      </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                      <ui:Button Margin="{StaticResource Osplay.Thickness.ButtonGap}" Content="{x:Static res:Strings.TrayRevoke}"
                                 Command="{Binding RevokeCommand}"
                                 Visibility="{Binding IsRevoked, Converter={StaticResource Osplay.Converter.InverseBooleanToVisibility}}" />
                      <ui:Button Content="{x:Static res:Strings.TrayRemove}" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                  </ui:CardControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Advanced: health, network, logs -->
      <TabItem Header="{x:Static res:Strings.SettingsAdvanced}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.HealthTitle}" Style="{StaticResource Osplay.Text.Section}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{Binding Connection.HealthStatusText}"
                       Style="{StaticResource Osplay.Text.Body}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{x:Static res:Strings.HealthRepair}"
                       Style="{StaticResource Osplay.Text.Caption}"
                       Visibility="{Binding Connection.HasHostProblem, Converter={StaticResource Osplay.Converter.BooleanToVisibility}}" />
            <ui:Button Margin="{StaticResource Osplay.Thickness.ItemGap}" Content="{x:Static res:Strings.HealthCheckAgain}"
                       Command="{Binding Connection.CheckHealthCommand}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{x:Static res:Strings.HealthCheckWhileSharing}"
                       Style="{StaticResource Osplay.Text.Caption}" />

            <TextBlock Text="{x:Static res:Strings.SettingsLogs}" Style="{StaticResource Osplay.Text.Section}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{Binding LogsFolder}"
                       Style="{StaticResource Osplay.Text.Caption}" />
            <ui:Button Margin="{StaticResource Osplay.Thickness.ItemGap}" Content="{x:Static res:Strings.SettingsLogsOpen}"
                       Command="{Binding OpenLogsCommand}" />

            <TextBlock Text="{x:Static res:Strings.DiagnosticsTitle}" Style="{StaticResource Osplay.Text.Section}" />
            <ui:Button Margin="{StaticResource Osplay.Thickness.ItemGap}" Content="{x:Static res:Strings.DiagnosticsCopy}"
                       Command="{Binding CopyDiagnosticsCommand}" />
            <TextBlock Margin="{StaticResource Osplay.Thickness.ItemGap}" Text="{Binding DiagnosticsResult}"
                       Style="{StaticResource Osplay.Text.Caption}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</ui:FluentWindow>
