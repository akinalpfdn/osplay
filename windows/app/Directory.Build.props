<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Documentation files are generated so IDE0005 works in builds; missing XML docs are not errors. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>Akinalp Fidan</Company>
    <Product>Osplay</Product>
    <Copyright>Copyright © 2026 Akinalp Fidan. MIT License.</Copyright>
    <Version>0.2.0</Version>
  </PropertyGroup>
</Project>
