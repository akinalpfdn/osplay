---
# Rationale for each disabled check lives next to it; everything else in these groups is an error.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -portability-avoid-pragma-once
# Byte-level codecs use reinterpret_cast and pointer arithmetic on bounded spans; magic numbers
# are reviewed by hand because wire offsets are documented in PROTOCOL.md next to their constants.
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(core|windows)/(include|src|engine|helper)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  # The public C API (osplay_*) follows C naming conventions.
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^osplay_[a-z0-9_]+$'
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '^osplay_[a-z0-9_]+$'
  - key: modernize-use-using.IgnoreExternC
    value: true
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^OSPLAY_[A-Z0-9_]+$'
...
