    "pad.settings.nameFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computers show this iPad by this name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarlar bu iPad'i bu adla gösterir."
          }
        }
      }
    },
    "pad.settings.noPaired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired computers yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eşleşmiş bilgisayar yok."
          }
        }
      }
    },
    "pad.settings.paired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired computers"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşmiş bilgisayarlar"
          }
        }
      }
    },
    "pad.settings.pairedFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left on a computer to revoke or remove it. A revoked computer is refused; a removed one asks for a pairing code again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bilgisayarı iptal etmek ya da kaldırmak için sola kaydırın. İptal edilen bilgisayar reddedilir; kaldırılan bilgisayar yeniden eşleşme kodu ister."
          }
        }
      }
    },
    "pad.settings.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldır"
          }
        }
      }
    },
    "pad.settings.revoke": {
      "extractionState": "manual",
