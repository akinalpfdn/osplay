    "error.virtualDisplay.creationFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS did not create the virtual display. Quit Osplay, open it again and retry."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sanal ekranı oluşturmadı. Osplay'den çıkıp yeniden açın ve tekrar deneyin."
          }
        }
      }
    },
    "error.virtualDisplay.displayDestroyed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The display has already been removed."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran zaten kaldırılmış."
          }
        }
      }
    },
