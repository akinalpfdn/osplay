        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran Kaydı izni kapatıldığı için paylaşım durdu. Sistem Ayarları → Gizlilik ve Güvenlik → Ekran Kaydı bölümünden yeniden açın ve tekrar bağlanın."
          }
        }
      }
    },
