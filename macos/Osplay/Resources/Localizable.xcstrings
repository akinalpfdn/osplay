        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS çözünürlüğü değiştiremedi (hata %lld). Sistem Ayarları → Ekranlar üzerinden tekrar deneyin."
          }
        }
      }
    },
